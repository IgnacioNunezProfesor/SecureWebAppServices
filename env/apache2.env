DOCKERFILE=./docker/apache2/apache2.dockerfile
DOCKER_COMPOSE_FILE=./docker/apache2/apache2.docker-compose.yml

DOCKER_IMAGE_NAME=apache2
DOCKER_CONTAINER_NAME=apache2
HTTP_APACHE2_SERVER_NAME=apache2.localhost

HTTP_APACHE2_LOCAL_CONF_DIR=./docker/apache2/assets/conf
HTTP_APACHE2_LOCAL_CONFD_DIR=./docker/apache2/assets/conf.d
HTTP_APACHE2_SERVER_CONF_DIR=/usr/local/apache2/conf/
HTTP_APACHE2_SERVER_CONFD_DIR=/usr/local/apache2/conf/

HTTP_APACHE2_SERVER_PORT=80
HTTP_APACHE2_LOCAL_PORT=80
HTTP_APACHE2_LOCAL_DEFAULT_FOLDER=../../wwwroots/default
HTTP_APACHE2_SERVER_DEFAULT_FOLDER=/usr/local/apache2/htdocs

HTTP_LOCAL_LOG_PATH=../../logs/apache2
HTTP_SERVER_LOG_PATH=/usr/local/apache2/logs

NETWORK_NAME=MyNet
NETWORK_DRIVER=bridge
NETWORK_SUBNET=172.20.0.0/16
NETWORK_SUBNET_GATEWAY=172.20.0.1
